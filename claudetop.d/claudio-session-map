#!/bin/bash
# claudetop plugin — writes iterm_session_id -> transcript_path on each render.
# Consumed by play-last.sh so the Claudio menu-bar / hotkey play the message
# from the *focused* iTerm pane, not whichever Claude session was last active.
#
# Key format: iTerm sets ITERM_SESSION_ID like "w0t0p0:UUID". AppleScript's
# `unique id of current session` may return just the UUID. We write both keys
# so the lookup from Hammerspoon matches regardless of which form it has.
#
# Outputs nothing — keeps the statusline visually unchanged.

set -eu

JSON=$(cat)
TRANSCRIPT=$(printf '%s' "$JSON" | jq -r '.transcript_path // empty' 2>/dev/null || true)
[ -z "${TRANSCRIPT:-}" ] && exit 0

SID="${ITERM_SESSION_ID:-}"
[ -z "$SID" ] && exit 0

MAP_DIR="$HOME/.claude/claudio/sessions"
mkdir -p "$MAP_DIR"

# Whitelist-based sanitization so the writer here and the reader in
# play-last.sh stay in lockstep. Any character outside [A-Za-z0-9_-] becomes
# '_' (consecutive runs are squashed) and the result is capped at 128 chars
# to keep filenames sane. Typical iTerm session IDs (`w0t0p0:UUID`, plain
# UUIDs) map to identical results under the prior `tr ':/ ' '___'` rule, so
# existing map entries still resolve until the 2-day GC sweeps them.
sanitize_sid() {
  printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9_-' '_' | tr -s '_' | cut -c1-128
}

write_key() {
  local key="$1"
  local safe
  safe=$(sanitize_sid "$key")
  [ -z "$safe" ] && return 0
  printf 'transcript_path=%s\nts=%s\n' "$TRANSCRIPT" "$(date +%s)" > "$MAP_DIR/$safe"
}

write_key "$SID"
# Also write keyed by the part after the last colon (AppleScript unique-id form)
UUID_PART="${SID##*:}"
if [ "$UUID_PART" != "$SID" ]; then
  write_key "$UUID_PART"
fi

# Garbage collect entries not touched in 2 days
find "$MAP_DIR" -type f -mtime +2 -delete 2>/dev/null || true

exit 0
