# Runtime state
state
speed
voice
*.pid
*.log
# Selection tempfiles (mktemp XXXXXX pattern) — normally unlinked by
# play-last.sh, but a hard-killed synth can leave one behind.
selection.*
# kokoro-tts.sh scratch dir (mktemp XXXXXX per synth); segments and
# per-sentence caches live here. Cleaned on EXIT trap, leaks on SIGKILL.
segments.*/
# Queue mode state (FIFO items + coordinator lock dir)
queue/
queue.lock/

# Per-sentence synth cache (SHA-256-keyed WAVs)
cache/

# Python venv (recreated by install.sh)
kokoro/venv/

# Downloaded model weights (fetched by kokoro/download-model.sh)
kokoro/kokoro-v1.0.onnx
kokoro/voices-v1.0.bin
# Patched model produced by kokoro/patch-model.sh (derived artifact, not committed)
kokoro/kokoro-v1.0-durations.onnx

# Python
.venv/
__pycache__/
*.egg-info/
*.pyc

# Editor / IDE
.idea/
.vscode/

# macOS
.DS_Store

# Benchmark artifacts (wav clips + spectrograms — not committed, for local A/B listening)
bench/

# graphify knowledge-graph artifacts (regenerable from `graphify update .`)
graphify-out/

# Claude Code per-session scratch: notes, worktrees, session state. The
# committed CLAUDE.md at repo root is the evergreen project-guide half;
# this directory holds the in-flight stuff (SESSION.md, agent worktrees)
# that only makes sense on this machine.
.claude/
last_text.dat
mirror.enabled
